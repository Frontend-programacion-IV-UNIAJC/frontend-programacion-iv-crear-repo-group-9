---
import type { SnackNormalizado } from "../../services/api.js";

interface Props {
  snack: SnackNormalizado;
}

const { snack } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const tieneImagen = Boolean(snack.imagen);
const srcImagen = !tieneImagen
  ? ""
  : snack.imagen.startsWith("http")
    ? snack.imagen
    : `${base}${snack.imagen.replace(/^\/+/, "")}`;

const hrefDetalle = `${base}catalogo/${encodeURIComponent(snack.id)}/`;
---

<article class="tarjeta">
  <div class="tarjeta_media">
    {tieneImagen ? (
      <img src={srcImagen} alt="" loading="lazy" width="320" height="240" />
    ) : (
      <div class="tarjeta_sin-imagen" aria-hidden="true">Sin foto</div>
    )}
  </div>
  <div class="tarjeta_cuerpo">
    <p class="tarjeta_marca">{snack.marca}</p>
    <h2 class="tarjeta_titulo">
      <a href={hrefDetalle}>{snack.nombre}</a>
    </h2>
  </div>
</article>

<style>
  .tarjeta {
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    background: var(--color-fondo);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sombra-1);
  }

  .tarjeta_media {
    aspect-ratio: 4 / 3;
    background: var(--color-superficie);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .tarjeta_media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tarjeta_sin-imagen {
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
    font-weight: 600;
  }

  .tarjeta_cuerpo {
    padding: var(--esp-3);
    display: grid;
    gap: var(--esp-1);
    min-width: 0;
  }

  .tarjeta_marca {
    margin: 0;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
    overflow-wrap: anywhere;
  }

  .tarjeta_titulo {
    margin: 0;
    font-size: var(--texto-base);
    overflow-wrap: anywhere;
  }

  .tarjeta_titulo a {
    text-decoration: none;
  }

  .tarjeta_titulo a:hover {
    text-decoration: underline;
    color: var(--color-marca);
  }
</style>